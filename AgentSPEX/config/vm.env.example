# Sandbox VM configuration — copy to `config/vm.env` and adjust.
# `config/vm.env` is git-ignored (see .gitignore); this template is committed.
# `run_vm.sh` sources this file and also passes it into the container via
# `docker run --env-file config/vm.env`.

# --- Workspace ------------------------------------------------------------
# The container-side mount point. The host path (HOST_WORKSPACE) is set in
# config/host.env and bind-mounted here.
VM_WORKSPACE=/workspace
VM_HOSTNAME=sandbox

# --- MCP server (required by src/sandbox_vm/mcp/server.py) -----------------
# The agent connects to http://localhost:${MCP_PORT}${MCP_BASEPATH}.
MCP_HOST=0.0.0.0
MCP_PORT=7002
MCP_BASEPATH=/mcp
MCP_TRANSPORT=http

# --- Display / VNC --------------------------------------------------------
# DISPLAY must match the Xvfb lock the entrypoint creates (/tmp/.X100-lock).
DISPLAY=:100
RDP_PORT=5900          # x11vnc rfb port (internal)
VNC_PORT=6080          # noVNC/websockify web port -> http://localhost:6080/vnc_auto.html
CDP_PORT=9222          # Chrome remote-debugging port (internal)

# --- Optional: Slack integration (see docs/integration-slack.md) ----------
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# SLACK_SLASH_COMMAND=agent

# --- Optional: Discord integration (see docs/integration-discord.md) ------
# DISCORD_BOT_TOKEN=...
# DISCORD_SLASH_COMMAND=agent
