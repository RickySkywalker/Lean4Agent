# Copy to `configs/LLM-config.env` and adjust. Real *.env files are
# git-ignored — never commit credentials.

# --- AWS Bedrock (the Quickstart examples use zai.glm-5 in us-west-2) ---
export AWS_REGION_NAME=us-west-2
export AWS_DEFAULT_REGION=us-west-2
# On EC2 an instance profile is picked up automatically; elsewhere also set:
# export AWS_ACCESS_KEY_ID=...
# export AWS_SECRET_ACCESS_KEY=...

# --- Model passed to the experiment runners (litellm route) ---
export MODEL_NAME="bedrock/zai.glm-5"
