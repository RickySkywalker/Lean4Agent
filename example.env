# Copy to `.env` and fill in. `.env` is git-ignored — never commit real keys.

# --- LLM provider (experiment runners + Layer-3 judge) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_BASE=

# --- AWS Bedrock (used by the experiment runners and the Layer-3 LLM judge) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
